generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  displayName  String
  timezone     String         @default("UTC")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  metrics      DailyMetric[]
  workouts     WorkoutLog[]
  meals        MealLog[]
  sleep        SleepSession[]
  wearableSync WearableSync[]
}

model DailyMetric {
  id              String   @id @default(cuid())
  user            User     @relation(fields: [userId], references: [id])
  userId          String
  date            DateTime
  calories        Int      @default(0)
  steps           Int      @default(0)
  sleepHours      Float    @default(0)
  workoutsMinutes Int      @default(0)
  waterIntakeOz   Float    @default(0)
  notes           String?

  @@unique([userId, date])
}

model WorkoutLog {
  id             String   @id @default(cuid())
  user           User     @relation(fields: [userId], references: [id])
  userId         String
  date           DateTime @default(now())
  type           String
  intensity      String   @default("moderate")
  durationMin    Int
  caloriesBurned Int?
  notes          String?
}

model MealLog {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  date      DateTime @default(now())
  mealType  String
  name      String
  calories  Int
  proteinG  Float    @default(0)
  carbsG    Float    @default(0)
  fatG      Float    @default(0)
  notes     String?
}

model SleepSession {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  startTime   DateTime
  endTime     DateTime
  quality     String   @default("unknown")
  interruptions Int    @default(0)
  notes       String?
}

model WearableSync {
  id            String   @id @default(cuid())
  user          User     @relation(fields: [userId], references: [id])
  userId        String
  provider      String
  payload       Json
  syncedAt      DateTime @default(now())
  status        String   @default("processed")
  errorMessage  String?
}
